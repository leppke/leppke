rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Csak az itt felsorolt e-mail címekkel bejelentkezett felhasználók
    // olvashatják a riportot. Írd át a valódi címekre (a saját admin címed
    // és a könyvelőé), majd deployold újra: firebase deploy --only firestore
    function allowedUser() {
      return request.auth != null &&
        request.auth.token.email in [
          'lleepppp@gmail.com',
          'konyvelo@example.com'
        ];
    }

    match /{document=**} {
      allow read: if allowedUser();
      // Írni csak a belső gép Python scriptje ír, a service account kulccsal
      // (az Admin SDK a szabályokat megkerüli) — kliensről tilos.
      allow write: if false;
    }
  }
}
